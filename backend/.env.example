# Backend environment template. Copy to .env for local development.
# `npm run setup:local` generates a .env automatically (with a random SECRET_KEY).

# Local default uses SQLite (no Docker required). For Postgres use e.g.:
# postgresql+psycopg://fitcoach:fitcoach@localhost:5432/fitcoach
DATABASE_URL=sqlite:///./fitcoach-local.db

# development | production. Production enforces a strong SECRET_KEY, secure cookies and non-local origins.
ENVIRONMENT=development

# Token signing key. MUST be replaced with a strong random value (>=32 chars) outside development.
SECRET_KEY=replace-with-a-strong-random-secret-min-32-chars

# Comma-separated list of allowed browser origins (CORS + WebSocket origin check).
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Send the auth cookie only over HTTPS. Must be true in production.
SECURE_COOKIES=false

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
