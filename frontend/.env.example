# Frontend environment template. Copy to .env.local for local development.
# `npm run setup:local` copies this file automatically.

# Browser-side API base. Leave unset to use the relative "/api/v1" path,
# which Next.js rewrites proxy to API_PROXY_TARGET (see next.config.ts).
# NEXT_PUBLIC_API_URL=

# WebSocket base for the live cockpit. Defaults to ws://127.0.0.1:8000/api/v1 when unset.
# NEXT_PUBLIC_WS_URL=

# Dev-only: where Next.js rewrites proxy /api/v1/* (the local FastAPI backend).
API_PROXY_TARGET=http://127.0.0.1:8000
